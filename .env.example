# Binance API credentials
# Get testnet keys: https://testnet.binance.vision/
# Get live keys:    https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Set to "true" to use Binance Spot Testnet (recommended).
# Set to "false" to trade live (real money). Requires LIVE_TRADING=true as well.
BINANCE_TESTNET=true

# Hard kill switch. Must be "true" to actually send orders to a live exchange.
# When "false", the system runs in dry-run mode and only logs intended trades.
LIVE_TRADING=false
