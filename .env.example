# Binance API credentials.
#
# Spot testnet keys:    https://testnet.binance.vision/
# Futures testnet keys: https://testnet.binancefuture.com/
# Live keys:            https://www.binance.com/en/my/settings/api-management
#
# IMPORTANT: spot and futures testnets each have their own separate keys.
# Use the keys that match exchange.market_type in config.yaml.
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Set to "true" to use the matching Binance testnet (recommended).
# Set to "false" to trade on real exchange. Requires LIVE_TRADING=true.
BINANCE_TESTNET=true

# Hard kill switch. Must be "true" to actually send orders to an exchange.
# When "false", the system runs in dry-run mode and only logs intended trades.
LIVE_TRADING=false
